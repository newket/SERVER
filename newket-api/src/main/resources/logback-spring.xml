
<configuration>

    <property name="LOG_PATTERN"
              value="%green(%d{yyyy-MM-dd HH:mm:ss}) [%highlight(%-5level)] --- [%magenta(%15.15t)] %msg%n"/>

    <property name="LOG_PATTERN_WITHOUT_COLOR"
              value="%d{yyyy-MM-dd HH:mm:ss} [%-5level] %msg%n"/>

    <!-- Console -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- File -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <encoder>
            <pattern>${LOG_PATTERN_WITHOUT_COLOR}</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>./log/%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Local -->
    <springProfile name="local | (!dev &amp; !prod)">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Dev -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- Prod -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- Reduce unnecessary logs -->
    <logger name="org.mongodb.driver.cluster" level="WARN"/>
    <logger name="org.hibernate.orm.results" level="WARN"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>

</configuration>
